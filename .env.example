# Node 24+; copy to .env. Never commit credentials.
# GitHub Pages build URL, including repository path if there is no custom domain.
SITE_URL=https://unquiethorn.com
STATIC_REFRESH_FEEDS=true
# Optional local development server (not required by GitHub Pages):
PORT=3000
HOST=127.0.0.1
# Production: public HTTPS origin, e.g. https://your-publication.example
SITE_ORIGIN=
DATABASE_PATH=./data/ledger.sqlite
AGGREGATION_ENABLED=true
POLL_INTERVAL_MINUTES=30
# Required by ReliefWeb v2: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# Recommended: Google Cloud Translation Basic v2, all supported site languages.
# Enable Cloud Translation API and restrict this key to that API. Server use only.
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_CHARACTERS_PER_MINUTE=60000
# Optional Microsoft fallback for Amharic/Tigrinya. Use Google for Afaan Oromo.
TRANSLATOR_KEY=
TRANSLATOR_REGION=
# Set a verified OHCHR publisher feed. No stable current URL has been confirmed.
OHCHR_RSS_URL=
# Optional overrides when publishers move their RSS feeds:
AMNESTY_RSS_URL=
HRW_RSS_URL=
ADDIS_STANDARD_RSS_URL=
ETHIOPIA_INSIGHT_RSS_URL=
ALLAFRICA_RSS_URL=
