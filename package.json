{
  "name": "the-unquiet-horn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch app/server.mjs",
    "aggregate": "node --env-file-if-exists=.env app/aggregate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node app/validate.mjs",
    "review-translation": "node app/review-translation.mjs",
    "build": "node --env-file-if-exists=.env app/static-build.mjs",
    "preview": "node app/preview-static.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.0",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}
